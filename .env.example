# Copy to .env.local for local testing with `vercel dev`.
# On Vercel, add these under Project -> Settings -> Environment Variables.
# Never commit the real values (.env* files are git-ignored).

# From resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact messages are delivered
CONTACT_TO_EMAIL=you@example.com

# Optional. Needs a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
# Leave unset to use Resend's test sender (delivers only to your own Resend account email).
# CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>
